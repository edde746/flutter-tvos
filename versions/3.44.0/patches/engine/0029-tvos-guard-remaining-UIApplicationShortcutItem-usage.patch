From: edde746 <86283021+edde746@users.noreply.github.com>
Date: Thu, 23 Apr 2026 23:12:15 +0200
Subject: [PATCH 29/48] tvos: guard remaining UIApplicationShortcutItem usage


diff --git a/engine/src/flutter/shell/platform/darwin/ios/framework/Source/FlutterPluginAppLifeCycleDelegate_internal.h b/engine/src/flutter/shell/platform/darwin/ios/framework/Source/FlutterPluginAppLifeCycleDelegate_internal.h
index c68505a5..dfc65834 100644
--- a/engine/src/flutter/shell/platform/darwin/ios/framework/Source/FlutterPluginAppLifeCycleDelegate_internal.h
+++ b/engine/src/flutter/shell/platform/darwin/ios/framework/Source/FlutterPluginAppLifeCycleDelegate_internal.h
@@ -91,7 +91,8 @@
  * the FlutterSceneLifeCycleDelegate protocol.
  */
 - (BOOL)sceneFallbackPerformActionForShortcutItem:(UIApplicationShortcutItem*)shortcutItem
-                                completionHandler:(void (^)(BOOL succeeded))completionHandler;
+                                completionHandler:(void (^)(BOOL succeeded))completionHandler
+    API_UNAVAILABLE(tvos);
 
 @end
 ;
diff --git a/engine/src/flutter/shell/platform/darwin/ios/framework/Source/FlutterSceneDelegate.mm b/engine/src/flutter/shell/platform/darwin/ios/framework/Source/FlutterSceneDelegate.mm
index 8973bd91..5099b40c 100644
--- a/engine/src/flutter/shell/platform/darwin/ios/framework/Source/FlutterSceneDelegate.mm
+++ b/engine/src/flutter/shell/platform/darwin/ios/framework/Source/FlutterSceneDelegate.mm
@@ -94,6 +94,7 @@ - (void)scene:(UIScene*)scene
 
 #pragma mark - Performing tasks
 
+#if !(defined(TARGET_OS_TV) && TARGET_OS_TV)
 - (void)windowScene:(UIWindowScene*)windowScene
     performActionForShortcutItem:(UIApplicationShortcutItem*)shortcutItem
                completionHandler:(void (^)(BOOL succeeded))completionHandler {
@@ -101,6 +102,7 @@ - (void)windowScene:(UIWindowScene*)windowScene
               performActionForShortcutItem:shortcutItem
                          completionHandler:completionHandler];
 }
+#endif
 
 #pragma mark - Helpers
 
diff --git a/engine/src/flutter/shell/platform/darwin/ios/framework/Source/FlutterSceneLifeCycle.mm b/engine/src/flutter/shell/platform/darwin/ios/framework/Source/FlutterSceneLifeCycle.mm
index 019de11b..8e6d2c2a 100644
--- a/engine/src/flutter/shell/platform/darwin/ios/framework/Source/FlutterSceneLifeCycle.mm
+++ b/engine/src/flutter/shell/platform/darwin/ios/framework/Source/FlutterSceneLifeCycle.mm
@@ -406,6 +406,7 @@ - (void)scene:(UIScene*)scene
 
 #pragma mark - Performing tasks
 
+#if !(defined(TARGET_OS_TV) && TARGET_OS_TV)
 - (void)windowScene:(UIWindowScene*)windowScene
     performActionForShortcutItem:(UIApplicationShortcutItem*)shortcutItem
                completionHandler:(void (^)(BOOL succeeded))completionHandler {
@@ -426,6 +427,7 @@ - (void)windowScene:(UIWindowScene*)windowScene
                                 completionHandler:completionHandler];
   }
 }
+#endif
 
 #pragma mark - Helpers
 
@@ -625,6 +627,7 @@ - (BOOL)scene:(UIScene*)scene continueUserActivity:(NSUserActivity*)userActivity
 
 #pragma mark - Performing tasks
 
+#if !(defined(TARGET_OS_TV) && TARGET_OS_TV)
 - (BOOL)windowScene:(UIWindowScene*)windowScene
     performActionForShortcutItem:(UIApplicationShortcutItem*)shortcutItem
                completionHandler:(void (^)(BOOL succeeded))completionHandler {
@@ -640,4 +643,5 @@ - (BOOL)windowScene:(UIWindowScene*)windowScene
   }
   return NO;
 }
+#endif
 @end
diff --git a/engine/src/flutter/shell/platform/darwin/ios/framework/Source/FlutterSceneLifeCycle_Internal.h b/engine/src/flutter/shell/platform/darwin/ios/framework/Source/FlutterSceneLifeCycle_Internal.h
index 749c73b1..5c41fdc7 100644
--- a/engine/src/flutter/shell/platform/darwin/ios/framework/Source/FlutterSceneLifeCycle_Internal.h
+++ b/engine/src/flutter/shell/platform/darwin/ios/framework/Source/FlutterSceneLifeCycle_Internal.h
@@ -80,7 +80,8 @@
 
 - (BOOL)windowScene:(UIWindowScene*)windowScene
     performActionForShortcutItem:(UIApplicationShortcutItem*)shortcutItem
-               completionHandler:(void (^)(BOOL succeeded))completionHandler;
+               completionHandler:(void (^)(BOOL succeeded))completionHandler
+    API_UNAVAILABLE(tvos);
 
 @end
 
