-// Synthesizes a HardwareKeyboard event for a Siri Remote press whose
-// |press.key| is nil (Apple does not populate UIKey for remote buttons,
-// only for physical keyboards). The standard handlePressEvent: path bails
-// out for nil keys, so without this the modern key channel never sees the
-// event and Flutter Focus traversal silently drops directional clicks.
-- (void)maybeSynthesizeForPress:(UIPress*)press
+- (BOOL)isRepeatablePressType:(UIPressType)pressType {
+  switch (pressType) {
+    case UIPressTypeLeftArrow:
+    case UIPressTypeRightArrow:
+    case UIPressTypeUpArrow:
+    case UIPressTypeDownArrow:
+      return YES;
+    default:
+      return NO;
+  }
+}
+
+- (uint64_t)logicalForSynthesizedPhysicalKey:(uint64_t)physical {
+  switch (physical) {
+    case 0x00070050ULL:
+      return 0x100000302ULL;  // LogicalKeyboardKey.arrowLeft
+    case 0x0007004FULL:
+      return 0x100000303ULL;  // LogicalKeyboardKey.arrowRight
+    case 0x00070052ULL:
+      return 0x100000304ULL;  // LogicalKeyboardKey.arrowUp
+    case 0x00070051ULL:
+      return 0x100000301ULL;  // LogicalKeyboardKey.arrowDown
+    case 0x00070077ULL:
+      return 0x10000050CULL;  // LogicalKeyboardKey.select
+    case 0x00070029ULL:
+      return 0x10000001BULL;  // LogicalKeyboardKey.escape
+    default:
+      return 0;
+  }
+}
+
+- (void)releaseAllSynthesizedPresses {
+  [self stopSynthesizedRepeat];
+
+  NSArray<NSNumber*>* pressedKeys = [self.synthesizedPressedKeys allObjects];
+  for (NSNumber* key in pressedKeys) {
+    uint64_t physical = key.unsignedLongLongValue;
+    uint64_t logical = [self logicalForSynthesizedPhysicalKey:physical];
+    if (logical == 0) {
+      [self.synthesizedPressedKeys removeObject:key];
+      continue;
+    }
+    [self sendSynthesizedKeyEventOfType:kFlutterKeyEventTypeUp physical:physical logical:logical];
+  }
+}
+
+- (void)sendSynthesizedRepeat {
+  NSNumber* physicalKey = self.synthesizedRepeatPhysicalKey;
+  if (physicalKey == nil) {
+    return;
+  }
+  [self sendSynthesizedKeyEventOfType:kFlutterKeyEventTypeRepeat
+                             physical:physicalKey.unsignedLongLongValue
+                              logical:self.synthesizedRepeatLogicalKey];
+}
+
+- (void)stopSynthesizedRepeat {
+  [self.synthesizedRepeatDelayTimer invalidate];
+  [self.synthesizedRepeatTimer invalidate];
+  self.synthesizedRepeatDelayTimer = nil;
+  self.synthesizedRepeatTimer = nil;
+  self.synthesizedRepeatPhysicalKey = nil;
+  self.synthesizedRepeatLogicalKey = 0;
+}
+
+- (void)startSynthesizedRepeatWithPhysical:(uint64_t)physical logical:(uint64_t)logical {
+  [self stopSynthesizedRepeat];
+  self.synthesizedRepeatPhysicalKey = @(physical);
+  self.synthesizedRepeatLogicalKey = logical;
+
+  __weak FlutterViewController* weakSelf = self;
+  self.synthesizedRepeatDelayTimer =
+      [NSTimer scheduledTimerWithTimeInterval:0.4
+                                      repeats:NO
+                                        block:^(NSTimer* _Nonnull timer) {
+                                          FlutterViewController* strongSelf = weakSelf;
+                                          if (!strongSelf) {
+                                            return;
+                                          }
+                                          [strongSelf sendSynthesizedRepeat];
+                                          strongSelf.synthesizedRepeatTimer =
+                                              [NSTimer scheduledTimerWithTimeInterval:0.08
+                                                                              repeats:YES
+                                                                                block:^(NSTimer* _Nonnull timer) {
+                                                                                  [weakSelf sendSynthesizedRepeat];
+                                                                                }];
+                                        }];
+}
+
+- (BOOL)remotePhysicalLogicalForPress:(UIPress*)press
+                             physical:(uint64_t*)outPhysical
+                              logical:(uint64_t*)outLogical API_AVAILABLE(tvos(13.4)) {
+  if (@available(tvOS 13.4, *)) {
+    if (![self physicalLogicalForPressType:press.type
+                                  physical:outPhysical
+                                   logical:outLogical]) {
+      return NO;
+    }
+
+    // Apple documents UIPress.key as hardware-keyboard-only. Siri Remote
+    // presses are therefore handled by UIPress.type, not UIKey.keyCode. Some
+    // tvOS remote paths still reach UIKit's key responder with a nil UIKey or
+    // a zero keyCode; zero is USB HID's reserved usage, and Flutter's normal
+    // iOS fallback mints it as 0x01300000000. Consume those remote presses here
+    // so the app receives the semantic arrow/select key instead.
+    if (press.key == nil || press.key.keyCode == 0) {
+      return YES;
+    }
+
+    // Select is special on tvOS: a long-press Select release can surface with
+    // a UIKey-like payload and fall through as a raw enter/control key. The
+    // UIPress.type remains authoritative for the center/select button, and
+    // keyboard Enter has the same activation semantic on tvOS, so route it
+    // through the synthesized Select path instead of the generic iOS key path.
+    return press.type == UIPressTypeSelect;
+  }
+  return NO;
+}
+
+// Synthesizes a HardwareKeyboard event for a Siri Remote press. UIKit exposes
+// remote semantics through UIPress.type, while Flutter's normal iOS UIKey path
+// only knows hardware-keyboard HID usages.
+- (BOOL)maybeSynthesizeForPress:(UIPress*)press
                       eventType:(FlutterKeyEventType)type API_AVAILABLE(tvos(13.4)) {
   if (@available(tvOS 13.4, *)) {
-    if (press.key != nil) {
-      // Hardware keyboard — embedder responder will emit; don't duplicate.
-      return;
+    if (press.type == UIPressTypeSelect) {
+      // Select long-press delivery is more reliable through
+      // UIPressGestureRecognizer. Consume the UIKit press lifecycle so it
+      // cannot fall through as raw Enter, but let handleCenterTap own the
+      // down/up events that widgets use for long-press timers.
+      return YES;
     }
+
     uint64_t physical = 0;
     uint64_t logical = 0;
-    if (![self physicalLogicalForPressType:press.type
-                                  physical:&physical
-                                   logical:&logical]) {
-      return;
+    if (![self remotePhysicalLogicalForPress:press physical:&physical logical:&logical]) {
+      return NO;
+    }
+    if (type == kFlutterKeyEventTypeUp) {
+      if (self.synthesizedRepeatPhysicalKey.unsignedLongLongValue == physical) {
+        [self stopSynthesizedRepeat];
+      }
+    }
+    BOOL sent = [self sendSynthesizedKeyEventOfType:type physical:physical logical:logical];
+    if (sent && type == kFlutterKeyEventTypeDown && [self isRepeatablePressType:press.type]) {
+      [self startSynthesizedRepeatWithPhysical:physical logical:logical];
     }
-    [self sendSynthesizedKeyEventOfType:type physical:physical logical:logical];
+    return YES;
   }
+  return NO;
 }
 
