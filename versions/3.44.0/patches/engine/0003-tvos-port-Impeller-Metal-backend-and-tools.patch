   stream << "<<<<<<<";
   VALIDATION_LOG << stream.str();
@@ -115,7 +122,7 @@ static bool LogMTLCommandBufferErrorIfPresent(id<MTLCommandBuffer> buffer) {
 }
 
 static id<MTLCommandBuffer> CreateCommandBuffer(id<MTLCommandQueue> queue) {
-#ifndef FLUTTER_RELEASE
+#if !defined(FLUTTER_RELEASE) && !(defined(TARGET_OS_TV) && TARGET_OS_TV)
   if (@available(iOS 14.0, macOS 11.0, *)) {
     auto desc = [[MTLCommandBufferDescriptor alloc] init];
     // Degrades CPU performance slightly but is well worth the cost for typical
@@ -123,7 +130,7 @@ static bool LogMTLCommandBufferErrorIfPresent(id<MTLCommandBuffer> buffer) {
     desc.errorOptions = MTLCommandBufferErrorOptionEncoderExecutionStatus;
     return [queue commandBufferWithDescriptor:desc];
   }
-#endif  // FLUTTER_RELEASE
+#endif  // !defined(FLUTTER_RELEASE) && !(defined(TARGET_OS_TV) && TARGET_OS_TV)
   return [queue commandBuffer];
 }
 
diff --git a/engine/src/flutter/impeller/renderer/backend/metal/context_mtl.mm b/engine/src/flutter/impeller/renderer/backend/metal/context_mtl.mm
index c842a5ca..eaa77fe6 100644
--- a/engine/src/flutter/impeller/renderer/backend/metal/context_mtl.mm
+++ b/engine/src/flutter/impeller/renderer/backend/metal/context_mtl.mm
@@ -29,15 +29,23 @@ static bool DeviceSupportsFramebufferFetch(id<MTLDevice> device) {
   // According to
   // https://developer.apple.com/metal/Metal-Feature-Set-Tables.pdf, Apple2
   // corresponds to iOS GPU family 2, which supports A8 devices.
+#if !(defined(TARGET_OS_TV) && TARGET_OS_TV)
   return [device supportsFamily:MTLGPUFamilyApple2];
+#else
+  return [device supportsFeatureSet:MTLFeatureSet_tvOS_GPUFamily1_v1];
+#endif
 #endif  // FML_OS_IOS_SIMULATOR
 }
 
 static bool DeviceSupportsComputeSubgroups(id<MTLDevice> device) {
+#if !(defined(TARGET_OS_TV) && TARGET_OS_TV)
   // Refer to the "SIMD-scoped reduction operations" feature in the table
   // below: https://developer.apple.com/metal/Metal-Feature-Set-Tables.pdf
   return [device supportsFamily:MTLGPUFamilyApple7] ||
          [device supportsFamily:MTLGPUFamilyMac2];
+#else
+  return false;
+#endif
 }
 
 // See "Extended Range and wide color pixel formats" in the Metal Feature Set
@@ -46,7 +54,11 @@ static bool DeviceSupportsComputeSubgroups(id<MTLDevice> device) {
 // This includes all iOS devices with A9+ chip and Apple Silicon Macs (M1+).
 // Intel Macs (Mac2 family) do not support wide gamut.
 static bool DeviceSupportsExtendedRangeFormats(id<MTLDevice> device) {
+#if !(defined(TARGET_OS_TV) && TARGET_OS_TV)
   return [device supportsFamily:MTLGPUFamilyApple3];
+#else
+  return false;
+#endif
 }
 
 static std::unique_ptr<Capabilities> InferMetalCapabilities(
