 static const std::map<std::string, TargetPlatform> kKnownPlatforms = {
     {"metal-desktop", TargetPlatform::kMetalDesktop},
     {"metal-ios", TargetPlatform::kMetalIOS},
+    {"metal-tvos", TargetPlatform::kMetalIOS},
