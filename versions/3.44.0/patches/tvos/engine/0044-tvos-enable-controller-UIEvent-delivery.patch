-#if defined(TARGET_OS_TV) && TARGET_OS_TV
-static FlutterViewController* FlutterTvosFlutterViewControllerForResponder(UIResponder* responder) {
-  UIResponder* current = responder;
-  while (current != nil) {
-    if ([current isKindOfClass:[FlutterViewController class]]) {
-      return (FlutterViewController*)current;
-    }
-    current = current.nextResponder;
-  }
-  return nil;
-}
-
-static FlutterViewController* FlutterTvosFindFlutterViewController(UIViewController* controller) {
-  if (controller == nil) {
-    return nil;
-  }
-  if ([controller isKindOfClass:[FlutterViewController class]]) {
-    return (FlutterViewController*)controller;
-  }
-
-  FlutterViewController* presented =
-      FlutterTvosFindFlutterViewController(controller.presentedViewController);
-  if (presented != nil) {
-    return presented;
-  }
-
-  if ([controller isKindOfClass:[UINavigationController class]]) {
-    FlutterViewController* selected = FlutterTvosFindFlutterViewController(
-        ((UINavigationController*)controller).visibleViewController);
-    if (selected != nil) {
-      return selected;
-    }
-  } else if ([controller isKindOfClass:[UITabBarController class]]) {
-    FlutterViewController* selected = FlutterTvosFindFlutterViewController(
-        ((UITabBarController*)controller).selectedViewController);
-    if (selected != nil) {
-      return selected;
-    }
-  }
-
-  for (UIViewController* child in controller.childViewControllers) {
-    FlutterViewController* match = FlutterTvosFindFlutterViewController(child);
-    if (match != nil) {
-      return match;
-    }
-  }
-  return nil;
-}
-
-static FlutterViewController* FlutterTvosFlutterViewControllerForPress(UIPress* press,
-                                                                        UIWindow* window) {
-  FlutterViewController* responderController =
-      FlutterTvosFlutterViewControllerForResponder(press.responder);
-  if (responderController != nil) {
-    return responderController;
-  }
-  UIWindow* targetWindow = press.window;
-  if (targetWindow == nil) {
-    targetWindow = window;
-  }
-  return FlutterTvosFindFlutterViewController(targetWindow.rootViewController);
-}
-
-static BOOL FlutterTvosHandlePressesEvent(UIEvent* event, UIWindow* window) API_AVAILABLE(tvos(13.4)) {
-  if (@available(tvOS 13.4, *)) {
-    if (event.type != UIEventTypePresses || ![event respondsToSelector:@selector(allPresses)]) {
-      return NO;
-    }
-
-    BOOL handledAny = NO;
-    BOOL hasUnhandledPress = NO;
-    NSSet<UIPress*>* allPresses = ((UIPressesEvent*)event).allPresses;
-    for (UIPress* press in allPresses) {
-      FlutterViewController* viewController = FlutterTvosFlutterViewControllerForPress(press, window);
-      if (viewController == nil) {
-        hasUnhandledPress = YES;
-        continue;
-      }
-      if ([viewController tvosHandlePressFromUIEvent:press]) {
-        handledAny = YES;
-      } else {
-        hasUnhandledPress = YES;
-      }
-    }
-    return handledAny && !hasUnhandledPress;
-  }
-  return NO;
-}
-
-@implementation UIApplication (FlutterTvosPressEvents)
-+ (void)load {
-  static dispatch_once_t onceToken;
-  dispatch_once(&onceToken, ^{
-    Method original = class_getInstanceMethod([UIApplication class], @selector(sendEvent:));
-    Method swizzled = class_getInstanceMethod([UIApplication class], @selector(flutterTvos_sendEvent:));
-    if (original != nil && swizzled != nil) {
-      method_exchangeImplementations(original, swizzled);
-    }
-  });
-}
-
-- (void)flutterTvos_sendEvent:(UIEvent*)event {
-  BOOL handled = NO;
-  if (@available(tvOS 13.4, *)) {
-    handled = FlutterTvosHandlePressesEvent(event, nil);
-  }
-  if (!handled) {
-    [self flutterTvos_sendEvent:event];
-  }
-}
-@end
-
-@implementation UIWindow (FlutterTvosPressEvents)
-+ (void)load {
-  static dispatch_once_t onceToken;
-  dispatch_once(&onceToken, ^{
-    Method original = class_getInstanceMethod([UIWindow class], @selector(sendEvent:));
-    Method swizzled = class_getInstanceMethod([UIWindow class], @selector(flutterTvos_sendEvent:));
-    if (original != nil && swizzled != nil) {
-      method_exchangeImplementations(original, swizzled);
-    }
-  });
-}
-
-- (void)flutterTvos_sendEvent:(UIEvent*)event {
-  BOOL handled = NO;
-  if (@available(tvOS 13.4, *)) {
-    handled = FlutterTvosHandlePressesEvent(event, self);
-  }
-  if (!handled) {
-    [self flutterTvos_sendEvent:event];
-  }
-}
-@end
-#endif  // TARGET_OS_TV
-
 @implementation FlutterViewController {
   flutter::ViewportMetrics _viewportMetrics;
   MouseState _mouseState;
@@ -1255,38 +1117,6 @@ - (BOOL)synthesizeRemotePressType:(UIPressType)pressType
   return NO;
 }
 
-- (BOOL)tvosHandlePressFromUIEvent:(UIPress*)press API_AVAILABLE(tvos(13.4)) {
-  if (@available(tvOS 13.4, *)) {
-    if ([self shouldPassMenuPressToSystem:press]) {
-      return NO;
-    }
-    uint64_t physical = 0;
-    uint64_t logical = 0;
-    if (![self physicalLogicalForPressType:press.type physical:&physical logical:&logical]) {
-      return NO;
-    }
-
-    switch (press.phase) {
-      case UIPressPhaseBegan:
-      case UIPressPhaseChanged:
-      case UIPressPhaseStationary:
-        return [self synthesizeRemotePressType:press.type
-                                     eventType:kFlutterKeyEventTypeDown
-                                      physical:physical
-                                       logical:logical
-                          tapIfMissingKeyDown:NO];
-      case UIPressPhaseEnded:
-      case UIPressPhaseCancelled:
-        return [self synthesizeRemotePressType:press.type
-                                     eventType:kFlutterKeyEventTypeUp
-                                      physical:physical
-                                       logical:logical
-                          tapIfMissingKeyDown:YES];
-    }
-  }
-  return NO;
-}
