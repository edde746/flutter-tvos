From 56ecd8b61bc7b73ff26e7645f7fb2ce4b2ab13b5 Mon Sep 17 00:00:00 2001
From: edde746 <86283021+edde746@users.noreply.github.com>
Date: Fri, 29 May 2026 08:10:27 +0200
Subject: [PATCH 48/48] tvos: remove remote press diagnostics


diff --git a/engine/src/flutter/shell/platform/darwin/ios/framework/Source/FlutterViewController.mm b/engine/src/flutter/shell/platform/darwin/ios/framework/Source/FlutterViewController.mm
index 1df26c20..6ec02c7f 100644
--- a/engine/src/flutter/shell/platform/darwin/ios/framework/Source/FlutterViewController.mm
+++ b/engine/src/flutter/shell/platform/darwin/ios/framework/Source/FlutterViewController.mm
@@ -311,22 +311,13 @@ - (void)handleKeyboardAnimationCallbackWithTargetTime:(fml::TimePoint)targetTime
 
 static BOOL FlutterTvosHandlePressesEvent(UIEvent* event,
                                           UIWindow* window,
-                                          UIApplication* application,
-                                          NSString* source) API_AVAILABLE(tvos(13.4)) {
+                                          UIApplication* application) API_AVAILABLE(tvos(13.4)) {
   if (@available(tvOS 13.4, *)) {
     if (event.type != UIEventTypePresses || ![event respondsToSelector:@selector(allPresses)]) {
       return NO;
     }
 
     NSSet<UIPress*>* allPresses = ((UIPressesEvent*)event).allPresses;
-    os_log(OS_LOG_DEFAULT,
-           "Flutter tvOS press hook source=%{public}@ eventClass=%{public}@ presses=%{public}lu window=%{public}@ root=%{public}@",
-           source,
-           NSStringFromClass([event class]),
-           (unsigned long)allPresses.count,
-           window,
-           window.rootViewController);
-
     BOOL handledAny = NO;
     BOOL hasUnhandledPress = NO;
     for (UIPress* press in allPresses) {
@@ -336,15 +327,6 @@ static BOOL FlutterTvosHandlePressesEvent(UIEvent* event,
       if (flutterViewController != nil) {
         handled = [flutterViewController tvosHandlePressFromUIEvent:press];
       }
-      os_log(OS_LOG_DEFAULT,
-             "Flutter tvOS press source=%{public}@ type=%{public}ld phase=%{public}ld responder=%{public}@ pressWindow=%{public}@ flutterVC=%{public}@ handled=%{public}d",
-             source,
-             (long)press.type,
-             (long)press.phase,
-             press.responder,
-             press.window,
-             flutterViewController,
-             handled);
       if (handled) {
         handledAny = YES;
       } else {
@@ -377,7 +359,7 @@ + (void)load {
 - (void)flutterTvos_sendEvent:(UIEvent*)event {
   BOOL handled = NO;
   if (@available(tvOS 13.4, *)) {
-    handled = FlutterTvosHandlePressesEvent(event, nil, self, @"UIApplication");
+    handled = FlutterTvosHandlePressesEvent(event, nil, self);
   }
   if (!handled) {
     [self flutterTvos_sendEvent:event];
@@ -406,7 +388,7 @@ + (void)load {
 - (void)flutterTvos_sendEvent:(UIEvent*)event {
   BOOL handled = NO;
   if (@available(tvOS 13.4, *)) {
-    handled = FlutterTvosHandlePressesEvent(event, self, nil, @"UIWindow");
+    handled = FlutterTvosHandlePressesEvent(event, self, nil);
   }
   if (!handled) {
     [self flutterTvos_sendEvent:event];
@@ -1058,10 +1040,6 @@ - (void)surfaceUpdated:(BOOL)appeared {
 #pragma mark - remote tap handling
 #if defined(TARGET_OS_TV) && TARGET_OS_TV
 
-static void FlutterTvosSynthesizedKeyEventResponse(bool handled, void* userData) {
-  os_log(OS_LOG_DEFAULT, "Flutter tvOS synthesized key response handled=%{public}d", handled);
-}
-
 - (NSMutableSet<NSNumber*>*)synthesizedPressedKeys {
   if (!_synthesizedPressedKeys) {
     _synthesizedPressedKeys = [NSMutableSet set];
@@ -1107,9 +1085,7 @@ - (BOOL)sendSynthesizedKeyEventOfType:(FlutterKeyEventType)type
         .synthesized = true,
         .device_type = kFlutterKeyEventDeviceTypeDirectionalPad,
     };
-    [self.engine sendKeyEvent:flutterEvent
-                     callback:FlutterTvosSynthesizedKeyEventResponse
-                     userData:nullptr];
+    [self.engine sendKeyEvent:flutterEvent callback:nullptr userData:nullptr];
     return YES;
   }
   return NO;
