@@ -906,9 +1094,18 @@ - (void)sendGamepadTouchesWithType:(NSString*)type x:(float)x y:(float)y {
 
 - (void)setupTouchesWithGamepad:(GCMicroGamepad*)gamepad {
   gamepad.reportsAbsoluteDpadValues = true;
+  __weak FlutterViewController* weakSelf = self;
   gamepad.dpad.valueChangedHandler =
       ^(GCControllerDirectionPad* _Nonnull dpad, float xValue, float yValue) {
-        [self sendGamepadTouchesWithType:@"loc" x:xValue y:yValue];
+        FlutterViewController* strongSelf = weakSelf;
+        if (!strongSelf) {
+          return;
+        }
+        [strongSelf sendGamepadTouchesWithType:@"loc" x:xValue y:yValue];
+        // Translate dpad analog → discrete arrow keys so finger swipes on the
+        // 2nd/3rd-gen Siri Remote touch surface drive Flutter's focus traversal.
+        [strongSelf updateDpadAxis:0 value:xValue];
+        [strongSelf updateDpadAxis:1 value:yValue];
       };
 }
 
