-        return [self synthesizeRemotePressType:press.type
-                                     eventType:kFlutterKeyEventTypeUp
-                                      physical:physical
-                                       logical:logical
-                           tapIfMissingKeyDown:YES];
+        if (engineOwned) {
+          [self synthesizeRemotePressType:press.type
+                               eventType:kFlutterKeyEventTypeUp
+                                physical:physical
+                                 logical:logical];
+          return FlutterTvosPressRouteEngine;
+        }
+        if (systemOwned) {
+          dispatch_async(dispatch_get_main_queue(), ^{
+            [self.systemOwnedRemotePressKeys removeObject:key];
+          });
+          return FlutterTvosPressRouteSystem;
+        }
+        // A terminal phase without an engine-owned Begin is state repair only.
+        // Consume it without fabricating a new activation.
+        return FlutterTvosPressRouteEngine;
     }
   }
-  return NO;
+  return FlutterTvosPressRouteNotRemote;
+}
