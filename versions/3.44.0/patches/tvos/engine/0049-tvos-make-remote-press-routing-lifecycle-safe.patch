+- (void)testRemoteSelectLifecycleEmitsExactlyOneGenuineDownAndUp API_AVAILABLE(tvos(13.4)) {
+  FlutterTvosPressEngineMock* engine = [[FlutterTvosPressEngineMock alloc] init];
+  FlutterViewController* viewController = [[FlutterViewController alloc] initWithEngine:engine
+                                                                                nibName:nil
+                                                                                 bundle:nil];
+  constexpr uint64_t kSelectPhysical = 0x00070077ULL;
+  constexpr uint64_t kSelectLogical = 0x10000050CULL;
+
+  XCTAssertFalse([viewController synthesizeRemotePressType:UIPressTypeSelect
+                                                 eventType:kFlutterKeyEventTypeUp
+                                                  physical:kSelectPhysical
+                                                   logical:kSelectLogical]);
+  XCTAssertTrue([viewController synthesizeRemotePressType:UIPressTypeSelect
+                                                eventType:kFlutterKeyEventTypeDown
+                                                 physical:kSelectPhysical
+                                                  logical:kSelectLogical]);
+  XCTAssertFalse([viewController synthesizeRemotePressType:UIPressTypeSelect
+                                                 eventType:kFlutterKeyEventTypeDown
+                                                  physical:kSelectPhysical
+                                                   logical:kSelectLogical]);
+  XCTAssertTrue([viewController synthesizeRemotePressType:UIPressTypeSelect
+                                                eventType:kFlutterKeyEventTypeUp
+                                                 physical:kSelectPhysical
+                                                  logical:kSelectLogical]);
+  XCTAssertFalse([viewController synthesizeRemotePressType:UIPressTypeSelect
+                                                 eventType:kFlutterKeyEventTypeUp
+                                                  physical:kSelectPhysical
+                                                   logical:kSelectLogical]);
+
+  XCTAssertEqualObjects(engine.sentKeyEventTypes,
+                        (@[ @(kFlutterKeyEventTypeDown), @(kFlutterKeyEventTypeUp) ]));
+  XCTAssertEqualObjects(engine.sentKeyEventSynthesized, (@[ @NO, @NO ]));
+}
