+    if (![self remotePhysicalLogicalForPress:press physical:&physical logical:&logical]) {
+      return FlutterTvosPressRouteNotRemote;
     }
 
+    NSNumber* key = @(physical);
+    BOOL engineOwned = [self.synthesizedPressedKeys containsObject:key];
+    BOOL systemOwned = [self.systemOwnedRemotePressKeys containsObject:key];
+
     switch (press.phase) {
       case UIPressPhaseBegan:
+        if (engineOwned) {
