-- (void)handleCenterTap:(UITapGestureRecognizer*)recognizer {
-  // Forward center/select lifecycle over the legacy gamepad-touch channel. On
-  // physical tvOS release builds this is the reliable path; Plezy turns click_s
-  // and click_e into a real KeyDown/KeyUp pair for long-press timers.
-  if (recognizer.state == UIGestureRecognizerStateBegan) {
-    [self sendGamepadTouchesWithType:@"click_s" x:0 y:0];
-  } else if (recognizer.state == UIGestureRecognizerStateEnded) {
-    [self sendGamepadTouchesWithType:@"click_e" x:0 y:0];
-  }
-}
 - (void)handlePlayPauseTap:(UITapGestureRecognizer*)recognizer {
   // No such key on macOS so we fake android
   [self handleTap:recognizer withType:@"android" keyType:0x55];
 }
-- (void)handleMenuTap:(UITapGestureRecognizer*)recognizer {
-  if (self.menuPressPassthroughEnabled) {
-    return;
-  }
-
-  // Back/Menu is also sent atomically on Began. Waiting for Ended on tvOS can
-  // delay release across route changes, which used to replay stale back input.
-  //
-  // Menu's gesture lifecycle on tvOS is unreliable: tvOS reserves
-  // long-press-Menu for "go home," and the OS frequently delays or
-  // omits the recognizer's StateEnded/Cancelled transition for the
-  // *release* of a Menu tap until another press arrives to kick it
-  // (observed gap: >8s between Began and Ended). Waiting on Ended/
-  // Cancelled to emit keyup leaves the previous keydown's physical key
-  // pinned in synthesizedPressedKeys, which then dedup-swallows the
-  // following press's keydown.
-  //
-  // Since Apple owns Menu's long-press semantic anyway and apps cannot
-  // distinguish hold from tap on Menu, treat every Menu recognition as
-  // an atomic tap: emit keydown + keyup together on StateBegan and stop
-  // tracking lifecycle from there.
-  if (recognizer.state == UIGestureRecognizerStateBegan) {
-    [self releaseAllSynthesizedPresses];
-    [self sendTap:0x04 withType:@"android" ofType:@"keydown"];
-    [self sendTap:0x04 withType:@"android" ofType:@"keyup"];
-  }
-}
 - (void)handlePageUpTap:(UITapGestureRecognizer*)recognizer API_AVAILABLE(tvos(14.3)) {
   [self handleTap:recognizer withType:@"android" keyType:0xA6];
 }
