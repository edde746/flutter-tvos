-- (void)sendSynthesizedPressType:(UIPressType)pressType pressed:(BOOL)pressed {
-  if (@available(tvOS 13.4, *)) {
-    uint64_t physical = 0;
-    uint64_t logical = 0;
-    if (![self physicalLogicalForPressType:pressType physical:&physical logical:&logical]) {
-      return;
-    }
-    if (!pressed && self.synthesizedRepeatPhysicalKey.unsignedLongLongValue == physical) {
-      [self stopSynthesizedRepeat];
-    }
-    BOOL sent = [self sendSynthesizedKeyEventOfType:pressed ? kFlutterKeyEventTypeDown : kFlutterKeyEventTypeUp
-                                          physical:physical
-                                           logical:logical];
-    if (sent && pressed && [self isRepeatablePressType:pressType]) {
-      [self startSynthesizedRepeatWithPhysical:physical logical:logical];
-    }
