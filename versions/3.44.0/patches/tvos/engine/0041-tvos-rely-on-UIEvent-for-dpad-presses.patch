-- (void)setupDirectionalGamepadFallbacks:(GCMicroGamepad*)gamepad {
-  // The 2021 2nd-generation Siri Remote exposes physical outer-ring clicks
-  // as a dedicated digital cardinal dpad. This avoids treating touch-surface
-  // swipes or lift drift as button clicks.
-#pragma clang diagnostic push
-#pragma clang diagnostic ignored "-Wunguarded-availability-new"
-  if (GCInputDirectionalCardinalDpad != nil) {
-    GCControllerDirectionPad* cardinalDpad = gamepad.dpads[GCInputDirectionalCardinalDpad];
-    if (cardinalDpad != nil) {
-      [self setupGameControllerButton:cardinalDpad.up pressType:UIPressTypeUpArrow];
-      [self setupGameControllerButton:cardinalDpad.down pressType:UIPressTypeDownArrow];
-      [self setupGameControllerButton:cardinalDpad.left pressType:UIPressTypeLeftArrow];
-      [self setupGameControllerButton:cardinalDpad.right pressType:UIPressTypeRightArrow];
-    }
-  }
-#pragma clang diagnostic pop
-}
