-              withType:(NSString*)keyMapType
-               keyType:(int)key {
-  if (recognizer.state == UIGestureRecognizerStateBegan) {
-    [self sendTap:key withType:keyMapType ofType:@"keydown"];
-    [self sendTap:key withType:keyMapType ofType:@"keyup"];
