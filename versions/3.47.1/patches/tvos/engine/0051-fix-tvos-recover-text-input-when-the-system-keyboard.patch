+// Regression: an editing session whose keyboard never made it on screen (its
+// presentation was dropped mid-dismissal of the previous session) must not
+// black-hole remote presses — nothing native exists to consume them, so they
+// belong to the engine, where the framework can recover the session.
+- (void)testEditingSessionWithoutPresentedKeyboardRoutesPressesToEngine API_AVAILABLE(tvos(13.4)) {
+  FlutterTvosPressEngineMock* engine = [[FlutterTvosPressEngineMock alloc] init];
+  FlutterViewController* viewController = [[FlutterViewController alloc] initWithEngine:engine
+                                                                                nibName:nil
+                                                                                 bundle:nil];
+  viewController.tvosNativeTextInputActive = YES;
+
+  XCTAssertEqual([viewController tvosRoutePress:RemotePress(UIPressTypeSelect, UIPressPhaseBegan)],
+                 FlutterTvosPressRouteEngine);
+  XCTAssertEqual([viewController tvosRoutePress:RemotePress(UIPressTypeSelect, UIPressPhaseEnded)],
+                 FlutterTvosPressRouteEngine);
+  XCTAssertEqualObjects(engine.sentKeyEventTypes,
+                        (@[ @(kFlutterKeyEventTypeDown), @(kFlutterKeyEventTypeUp) ]));
 }
 
