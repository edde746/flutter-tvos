                  FlutterTvosPressRouteSystem);
@@ -192,6 +207,23 @@ - (void)testSystemOwnedPressFinishesAfterNativeTextInputEnds API_AVAILABLE(tvos(
   XCTAssertEqual([viewController tvosRoutePress:RemotePress(UIPressTypeSelect, UIPressPhaseEnded)],
                  FlutterTvosPressRouteSystem);
   XCTAssertEqual(engine.sentKeyEventTypes.count, 0u);
