 #endif
 
 #include "flutter/common/constants.h"
@@ -94,6 +95,7 @@ - (BOOL)synthesizeRemotePressType:(UIPressType)pressType
                           physical:(uint64_t)physical
                            logical:(uint64_t)logical
               tapIfMissingKeyDown:(BOOL)tapIfMissingKeyDown API_AVAILABLE(tvos(13.4));
+- (BOOL)tvosHandleWindowPressFromUIEvent:(UIPress*)press API_AVAILABLE(tvos(13.4));
 #else
 @interface FlutterViewController () <FlutterBinaryMessenger,
                                      UIScrollViewDelegate,
@@ -198,6 +200,94 @@ - (void)onFirstFrameRendered;
 
 @end
 
+#if defined(TARGET_OS_TV) && TARGET_OS_TV
+static FlutterViewController* FlutterTvosFindFlutterViewController(UIViewController* viewController) {
+  if (viewController == nil) {
+    return nil;
+  }
+
+  UIViewController* presentedViewController = viewController.presentedViewController;
+  if (presentedViewController != nil) {
+    return FlutterTvosFindFlutterViewController(presentedViewController);
+  }
+
+  if ([viewController isKindOfClass:[FlutterViewController class]]) {
+    return (FlutterViewController*)viewController;
+  }
+
+  if ([viewController isKindOfClass:[UINavigationController class]]) {
+    UINavigationController* navigationController = (UINavigationController*)viewController;
+    FlutterViewController* flutterViewController =
+        FlutterTvosFindFlutterViewController(navigationController.visibleViewController);
+    if (flutterViewController != nil) {
+      return flutterViewController;
+    }
+  }
+
+  if ([viewController isKindOfClass:[UITabBarController class]]) {
+    UITabBarController* tabBarController = (UITabBarController*)viewController;
+    FlutterViewController* flutterViewController =
+        FlutterTvosFindFlutterViewController(tabBarController.selectedViewController);
+    if (flutterViewController != nil) {
+      return flutterViewController;
+    }
+  }
+
+  for (UIViewController* childViewController in viewController.childViewControllers) {
+    FlutterViewController* flutterViewController =
+        FlutterTvosFindFlutterViewController(childViewController);
+    if (flutterViewController != nil) {
+      return flutterViewController;
+    }
+  }
+
+  return nil;
+}
+
+@interface UIWindow (FlutterTvosPressEvents)
+@end
+
+@implementation UIWindow (FlutterTvosPressEvents)
+
++ (void)load {
+  static dispatch_once_t onceToken;
+  dispatch_once(&onceToken, ^{
+    Method originalMethod = class_getInstanceMethod(self, @selector(sendEvent:));
+    Method replacementMethod = class_getInstanceMethod(self, @selector(flutterTvos_sendEvent:));
+    if (originalMethod == nil || replacementMethod == nil) {
+      return;
+    }
+    method_exchangeImplementations(originalMethod, replacementMethod);
+  });
+}
+
+- (void)flutterTvos_sendEvent:(UIEvent*)event {
+  if (@available(tvOS 13.4, *)) {
+    if (event.type == UIEventTypePresses && [event respondsToSelector:@selector(allPresses)]) {
+      FlutterViewController* flutterViewController =
+          FlutterTvosFindFlutterViewController(self.rootViewController);
+      NSSet<UIPress*>* allPresses = ((UIPressesEvent*)event).allPresses;
+      BOOL handledPress = NO;
+      BOOL unhandledPress = NO;
+      for (UIPress* press in allPresses) {
+        if ([flutterViewController tvosHandleWindowPressFromUIEvent:press]) {
+          handledPress = YES;
+        } else {
+          unhandledPress = YES;
+        }
+      }
+      if (handledPress && !unhandledPress) {
+        return;
+      }
+    }
+  }
+
+  [self flutterTvos_sendEvent:event];
+}
+
+@end
+#endif  // TARGET_OS_TV
+
 @implementation FlutterViewController {
   flutter::ViewportMetrics _viewportMetrics;
   MouseState _mouseState;
@@ -1037,7 +1127,7 @@ - (BOOL)synthesizeRemotePressType:(UIPressType)pressType
                          eventType:(FlutterKeyEventType)type
                           physical:(uint64_t)physical
                            logical:(uint64_t)logical
-              tapIfMissingKeyDown:(BOOL)tapIfMissingKeyDown API_AVAILABLE(tvos(13.4)) {
+               tapIfMissingKeyDown:(BOOL)tapIfMissingKeyDown API_AVAILABLE(tvos(13.4)) {
   if (@available(tvOS 13.4, *)) {
     NSNumber* key = @(physical);
     BOOL hasKeyDown = [self.synthesizedPressedKeys containsObject:key];
@@ -1061,6 +1151,40 @@ - (BOOL)synthesizeRemotePressType:(UIPressType)pressType
   return NO;
 }
 
+- (BOOL)tvosHandleWindowPressFromUIEvent:(UIPress*)press API_AVAILABLE(tvos(13.4)) {
+  if (@available(tvOS 13.4, *)) {
+    if ([self shouldPassMenuPressToSystem:press]) {
+      return NO;
+    }
+
+    uint64_t physical = 0;
+    uint64_t logical = 0;
+    if (![self physicalLogicalForPressType:press.type physical:&physical logical:&logical]) {
+      return NO;
+    }
+
+    switch (press.phase) {
+      case UIPressPhaseBegan:
+        return [self synthesizeRemotePressType:press.type
+                                     eventType:kFlutterKeyEventTypeDown
+                                      physical:physical
+                                       logical:logical
+                          tapIfMissingKeyDown:NO];
+      case UIPressPhaseEnded:
+      case UIPressPhaseCancelled:
+        return [self synthesizeRemotePressType:press.type
+                                     eventType:kFlutterKeyEventTypeUp
+                                      physical:physical
+                                       logical:logical
+                          tapIfMissingKeyDown:YES];
+      case UIPressPhaseChanged:
+      case UIPressPhaseStationary:
+        return YES;
+    }
+  }
+  return NO;
+}
