From e71610f19062264ed9471b8dd9b0e7ba8da1565a Mon Sep 17 00:00:00 2001
From: edde746 <86283021+edde746@users.noreply.github.com>
Date: Thu, 23 Apr 2026 23:02:05 +0200
Subject: [PATCH 26/53] tvos: emit apple-tvos swift target triple when is_tvos


diff --git a/engine/src/build/config/darwin/BUILD.gn b/engine/src/build/config/darwin/BUILD.gn
index 99731457..30e0acd7 100644
--- a/engine/src/build/config/darwin/BUILD.gn
+++ b/engine/src/build/config/darwin/BUILD.gn
@@ -23,7 +23,10 @@ config("compiler") {
   }
 
   # OS and deployment target.
-  if (is_ios) {
+  if (is_ios && is_tvos) {
+    _triplet_os = "apple-tvos"
+    _deployment_target = tvos_deployment_target
+  } else if (is_ios) {
     _triplet_os = "apple-ios"
     _deployment_target = ios_deployment_target
   } else if (is_mac) {
@@ -31,6 +34,7 @@ config("compiler") {
     _deployment_target = mac_deployment_target
   }
 
+
   # swiftc -swift-version flag.
   #
   # Swift 6 transition: As of April 2025, no public Flutter framework API is
@@ -61,7 +65,13 @@ config("compiler") {
     _swift_version,
   ]
 
-  if (use_ios_simulator) {
+  # tvos: pick the simulator toggle matching the target OS so the swiftc
+  # wrapper emits an apple-tvos*-simulator triple for tvOS simulator builds.
+  if (is_tvos) {
+    if (use_tvos_simulator) {
+      swiftflags += [ "--use-simulator" ]
+    }
+  } else if (use_ios_simulator) {
     swiftflags += [ "--use-simulator" ]
   }
 }
