+  OCMExpect([_delegate flutterTextInputView:inputView
+                              performAction:FlutterTextInputActionDone
+                                 withClient:123]);
+
+  [inputView tvosTextInputProxyShouldReturn];
+
+  OCMVerifyAll(_delegate);
+}
+
+- (void)testProxyEditingLifecycleControlsNativeRouting {
+  [self setClientWithConfiguration:self.configuration];
+  FlutterTextInputView* inputView = _plugin.activeView;
+
+  [inputView tvosTextInputProxyDidBeginEditing];
+  XCTAssertTrue(_viewController.tvosNativeTextInputActive);
+
+  [inputView tvosTextInputProxyDidEndEditing];
+  XCTAssertFalse(_viewController.tvosNativeTextInputActive);
+}
+
+@end
+
