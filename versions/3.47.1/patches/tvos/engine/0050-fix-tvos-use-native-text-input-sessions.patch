+- (NSRange)tvosRangeFromTextRange:(UITextRange*)range {
+  if (range == nil) {
+    return NSMakeRange(NSNotFound, 0);
+  }
+  NSInteger start = [_tvosTextInputProxy offsetFromPosition:_tvosTextInputProxy.beginningOfDocument
+                                                 toPosition:range.start];
+  NSInteger end = [_tvosTextInputProxy offsetFromPosition:_tvosTextInputProxy.beginningOfDocument
+                                               toPosition:range.end];
+  if (start < 0 || end < start) {
+    return NSMakeRange(NSNotFound, 0);
+  }
+  return [self clampSelection:NSMakeRange(start, end - start)
+                      forText:_tvosTextInputProxy.text ?: @""];
+}
+
+- (void)syncTvosTextInputProxy {
+  if (_syncingTvosTextInputProxy) {
+    return;
+  }
+
+  _syncingTvosTextInputProxy = YES;
+  _tvosTextInputProxy.keyboardType = self.keyboardType;
+  _tvosTextInputProxy.returnKeyType = self.returnKeyType;
+  _tvosTextInputProxy.keyboardAppearance = self.keyboardAppearance;
+  _tvosTextInputProxy.autocapitalizationType = self.autocapitalizationType;
+  _tvosTextInputProxy.autocorrectionType = self.autocorrectionType;
+  _tvosTextInputProxy.spellCheckingType = self.spellCheckingType;
+  _tvosTextInputProxy.enablesReturnKeyAutomatically = self.enablesReturnKeyAutomatically;
+  _tvosTextInputProxy.smartDashesType = self.smartDashesType;
+  _tvosTextInputProxy.smartQuotesType = self.smartQuotesType;
+  _tvosTextInputProxy.textContentType = self.textContentType;
+  _tvosTextInputProxy.secureTextEntry = self.secureTextEntry;
+
+  NSString* text = [NSString stringWithString:self.text];
+  if (![_tvosTextInputProxy.text isEqualToString:text]) {
+    _tvosTextInputProxy.text = text;
+  }
+
+  NSRange selectedRange = [(FlutterTextRange*)self.selectedTextRange range];
+  UITextPosition* start =
+      [_tvosTextInputProxy positionFromPosition:_tvosTextInputProxy.beginningOfDocument
+                                         offset:selectedRange.location];
+  UITextPosition* end = [_tvosTextInputProxy positionFromPosition:start
+                                                           offset:selectedRange.length];
+  if (start != nil && end != nil) {
+    _tvosTextInputProxy.selectedTextRange = [_tvosTextInputProxy textRangeFromPosition:start
+                                                                            toPosition:end];
+  }
+  _syncingTvosTextInputProxy = NO;
+}
+
+- (void)tvosTextInputProxyDidBeginEditing {
+  [self.textInputPlugin setTvosNativeTextInputActive:YES];
+}
+
+- (void)tvosTextInputProxyDidChange {
+  if (_syncingTvosTextInputProxy) {
+    return;
+  }
+
+  NSString* oldText = [NSString stringWithString:self.text];
+  NSString* newText = _tvosTextInputProxy.text ?: @"";
+  NSRange selectedRange = [self tvosRangeFromTextRange:_tvosTextInputProxy.selectedTextRange];
+  if (selectedRange.location == NSNotFound) {
+    selectedRange = NSMakeRange(newText.length, 0);
+  }
+  NSRange markedRange = [self tvosRangeFromTextRange:_tvosTextInputProxy.markedTextRange];
+  NSRange oldSelectedRange = [(FlutterTextRange*)self.selectedTextRange range];
+  NSRange oldMarkedRange = self.markedTextRange == nil
+                               ? NSMakeRange(NSNotFound, 0)
+                               : [(FlutterTextRange*)self.markedTextRange range];
+  BOOL textChanged = ![oldText isEqualToString:newText];
+  if (!textChanged && NSEqualRanges(selectedRange, oldSelectedRange) &&
+      NSEqualRanges(markedRange, oldMarkedRange)) {
+    return;
+  }
+
+  _syncingTvosTextInputProxy = YES;
+  [self setTextInputState:@{
+    @"text" : newText,
+    @"selectionBase" : @(selectedRange.location),
+    @"selectionExtent" : @(NSMaxRange(selectedRange)),
+    @"selectionAffinity" : @(_selectionAffinity),
+    @"selectionIsDirectional" : @NO,
+    @"composingBase" : markedRange.location == NSNotFound ? @(-1) : @(markedRange.location),
+    @"composingExtent" : markedRange.location == NSNotFound ? @(-1) : @(NSMaxRange(markedRange)),
+  }];
+  _syncingTvosTextInputProxy = NO;
+
+  if (_enableDeltaModel) {
+    if (textChanged) {
+      [self updateEditingStateWithDelta:flutter::TextEditingDelta(
+                                            [oldText UTF8String],
+                                            flutter::TextRange(0, oldText.length),
+                                            [newText UTF8String])];
+    } else {
+      [self updateEditingStateWithDelta:flutter::TextEditingDelta([oldText UTF8String])];
+    }
+  } else {
+    [self updateEditingState];
+  }
+}
+
+- (void)tvosTextInputProxyDidEndEditing {
+  [self.textInputPlugin setTvosNativeTextInputActive:NO];
+  if (!self.preventCursorDismissWhenResignFirstResponder) {
+    [self.textInputDelegate flutterTextInputView:self
+        didResignFirstResponderWithTextInputClient:_textInputClient];
+  }
+}
+
+- (void)tvosTextInputProxyShouldReturn {
+  BOOL shouldInsert = [self shouldChangeTextInRange:self.selectedTextRange replacementText:@"\n"];
+  if (shouldInsert) {
+    [self insertText:@"\n"];
+    [self syncTvosTextInputProxy];
+  }
+}
