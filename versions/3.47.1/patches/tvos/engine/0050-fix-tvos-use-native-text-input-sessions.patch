+    @"composingBase" : @(-1),
+    @"composingExtent" : @(-1),
+  }];
+
+  OCMExpect([_delegate flutterTextInputView:inputView
+                        updateEditingClient:123
+                                  withState:[OCMArg checkWithBlock:^BOOL(NSDictionary* state) {
+                                    return [state[@"text"] isEqualToString:@"native"] &&
+                                           [state[@"selectionBase"] integerValue] == 6 &&
+                                           [state[@"selectionExtent"] integerValue] == 6;
+                                  }]]);
+
+  UITextField* proxy = inputView.tvosTextInputProxy;
+  proxy.text = @"native";
+  UITextPosition* end = [proxy positionFromPosition:proxy.beginningOfDocument offset:6];
+  proxy.selectedTextRange = [proxy textRangeFromPosition:end toPosition:end];
+  [inputView tvosTextInputProxyDidChange];
+
+  OCMVerifyAll(_delegate);
+  XCTAssertEqualObjects(inputView.text, @"native");
+}
+
+- (void)testProxyReturnUsesConfiguredFlutterAction {
+  [self setClientWithConfiguration:self.configuration];
