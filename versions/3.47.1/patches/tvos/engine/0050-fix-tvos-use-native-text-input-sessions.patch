+
+- (void)setClientWithConfiguration:(NSDictionary*)configuration {
+  FlutterMethodCall* call = [FlutterMethodCall methodCallWithMethodName:@"TextInput.setClient"
+                                                              arguments:@[ @123, configuration ]];
+  [_plugin handleMethodCall:call
+                     result:^(id result){
+                     }];
+}
+
+- (void)testProxyUsesFlutterTraitsAndEditingState {
+  NSMutableDictionary* configuration = self.configuration;
+  configuration[@"obscureText"] = @YES;
+  [self setClientWithConfiguration:configuration];
+
+  FlutterTextInputView* inputView = _plugin.activeView;
+  [inputView setTextInputState:@{
+    @"text" : @"hello",
+    @"selectionBase" : @1,
+    @"selectionExtent" : @4,
+    @"selectionAffinity" : @"TextAffinity.downstream",
+    @"composingBase" : @(-1),
+    @"composingExtent" : @(-1),
