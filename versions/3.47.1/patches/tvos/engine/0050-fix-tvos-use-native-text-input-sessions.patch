+
+  UITextField* proxy = inputView.tvosTextInputProxy;
+  XCTAssertEqual(proxy.keyboardType, UIKeyboardTypeURL);
+  XCTAssertEqual(proxy.returnKeyType, UIReturnKeyDone);
+  XCTAssertEqual(proxy.keyboardAppearance, UIKeyboardAppearanceDark);
+  XCTAssertEqual(proxy.autocorrectionType, UITextAutocorrectionTypeNo);
+  XCTAssertTrue(proxy.secureTextEntry);
+  XCTAssertEqualObjects(proxy.text, @"hello");
+  XCTAssertEqual([proxy offsetFromPosition:proxy.beginningOfDocument
+                                toPosition:proxy.selectedTextRange.start],
+                 1);
+  XCTAssertEqual([proxy offsetFromPosition:proxy.beginningOfDocument
+                                toPosition:proxy.selectedTextRange.end],
+                 4);
