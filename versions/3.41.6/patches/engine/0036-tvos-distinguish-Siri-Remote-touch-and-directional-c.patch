-// Converts GCMicroGamepad's touch-surface dpad values into one-shot arrow-key
-// presses. The old Siri Remote reports touchpad movement through this profile;
-// emitting held key-downs here makes controls such as PIN spinners run away.
+// Returns YES when the most recent absolute clickpad/touchpad location is
+// clearly in a directional region. Center/ambiguous positions are left to the
+// normal Select path.
+- (BOOL)directionalPhysicalLogicalFromCurrentDpadPhysical:(uint64_t*)outPhysical
+                                                  logical:(uint64_t*)outLogical {
+  static const float kDirectionalClickThreshold = 0.55f;
+  static const NSTimeInterval kPositionStaleTimeout = 0.60;
+
+  if (!self.hasMicroGamepadPosition) {
+    return NO;
+  }
+
+  NSTimeInterval now = [[NSProcessInfo processInfo] systemUptime];
+  if (now - self.lastMicroGamepadTimestamp > kPositionStaleTimeout) {
+    return NO;
+  }
+
+  float absX = fabsf(self.lastMicroGamepadX);
+  float absY = fabsf(self.lastMicroGamepadY);
+  if (absX < kDirectionalClickThreshold && absY < kDirectionalClickThreshold) {
+    return NO;
+  }
+
+  NSInteger axisIndex = absX >= absY ? 0 : 1;
+  NSInteger direction = 0;
+  if (axisIndex == 0) {
+    direction = self.lastMicroGamepadX < 0 ? -1 : 1;
+  } else {
+    // GCControllerDirectionPad y: +1.0 = up, -1.0 = down.
+    direction = self.lastMicroGamepadY > 0 ? 1 : -1;
+  }
+  [self physicalLogicalForAxis:axisIndex direction:direction physical:outPhysical logical:outLogical];
+  return YES;
+}
+
+- (BOOL)recentlySentDirectionalClick {
+  static const NSTimeInterval kDirectionalClickSuppressSelectWindow = 0.20;
+  NSTimeInterval now = [[NSProcessInfo processInfo] systemUptime];
+  return now - self.lastDirectionalClickTimestamp < kDirectionalClickSuppressSelectWindow;
+}
+
+- (BOOL)handleDirectionalClickFromCurrentDpad {
+  uint64_t physical = 0;
+  uint64_t logical = 0;
+  if (![self directionalPhysicalLogicalFromCurrentDpadPhysical:&physical logical:&logical]) {
+    return NO;
+  }
+
+  static const NSTimeInterval kDirectionalClickCooldown = 0.08;
+  NSTimeInterval now = [[NSProcessInfo processInfo] systemUptime];
+  if (now - self.lastDirectionalClickTimestamp >= kDirectionalClickCooldown) {
+    [self sendSynthesizedKeyPressPhysical:physical logical:logical];
+    self.lastDirectionalClickTimestamp = now;
+  }
+  return YES;
+}
+
+// Converts movement across GCMicroGamepad's touch surface into paced one-shot
+// arrow-key presses. Absolute position is only used as the anchor; resting a
+// thumb on the new Siri Remote clickpad edge must not navigate until the user
+// swipes or physically clicks that region.
 - (void)updateDpadWithX:(float)xValue y:(float)yValue {
-  static const float kEnterThreshold = 0.6f;
-  static const float kExitThreshold = 0.25f;
+  static const float kTouchExitThreshold = 0.12f;
+  static const float kSwipeThreshold = 0.45f;
   static const NSTimeInterval kDirectionalCooldown = 0.12;
 
+  NSTimeInterval now = [[NSProcessInfo processInfo] systemUptime];
+  self.lastMicroGamepadX = xValue;
+  self.lastMicroGamepadY = yValue;
+  self.hasMicroGamepadPosition = YES;
+  self.lastMicroGamepadTimestamp = now;
+
   float absX = fabsf(xValue);
   float absY = fabsf(yValue);
-  if (absX < kExitThreshold && absY < kExitThreshold) {
+  if (absX < kTouchExitThreshold && absY < kTouchExitThreshold) {
+    self.dpadTouchActive = NO;
     self.dpadDirection = 0;
     return;
   }
 
-  if (absX < kEnterThreshold && absY < kEnterThreshold) {
+  if (!self.dpadTouchActive) {
+    self.dpadTouchActive = YES;
+    self.dpadSwipeAnchorX = xValue;
+    self.dpadSwipeAnchorY = yValue;
     return;
   }
 
-  NSInteger axisIndex = absX >= absY ? 0 : 1;
+  float deltaX = xValue - self.dpadSwipeAnchorX;
+  float deltaY = yValue - self.dpadSwipeAnchorY;
+  float absDeltaX = fabsf(deltaX);
+  float absDeltaY = fabsf(deltaY);
+  if (absDeltaX < kSwipeThreshold && absDeltaY < kSwipeThreshold) {
+    return;
+  }
+
+  NSInteger axisIndex = absDeltaX >= absDeltaY ? 0 : 1;
   NSInteger direction = 0;
   if (axisIndex == 0) {
-    direction = xValue < 0 ? -1 : 1;
+    direction = deltaX < 0 ? -1 : 1;
   } else {
     // GCControllerDirectionPad y: +1.0 = up, -1.0 = down.
-    direction = yValue > 0 ? 1 : -1;
+    direction = deltaY > 0 ? 1 : -1;
   }
 
-  if (self.dpadDirection != 0 && self.dpadAxisIndex == axisIndex &&
-      self.dpadDirection == direction) {
-    return;
-  }
-
-  NSTimeInterval now = [[NSProcessInfo processInfo] systemUptime];
   if (now - self.lastDpadKeyTimestamp < kDirectionalCooldown) {
     return;
   }
@@ -1051,6 +1142,8 @@ - (void)updateDpadWithX:(float)xValue y:(float)yValue {
   uint64_t logical = 0;
   [self physicalLogicalForAxis:axisIndex direction:direction physical:&physical logical:&logical];
   [self sendSynthesizedKeyPressPhysical:physical logical:logical];
+  self.dpadSwipeAnchorX = xValue;
+  self.dpadSwipeAnchorY = yValue;
   self.dpadAxisIndex = axisIndex;
   self.dpadDirection = direction;
   self.lastDpadKeyTimestamp = now;
@@ -1144,6 +1237,14 @@ - (void)setupTouchesWithGamepad:(GCMicroGamepad*)gamepad {
         [strongSelf sendGamepadTouchesWithType:@"loc" x:xValue y:yValue];
         [strongSelf updateDpadWithX:xValue y:yValue];
       };
+  gamepad.buttonA.pressedChangedHandler =
+      ^(GCControllerButtonInput* _Nonnull button, float value, BOOL pressed) {
+        FlutterViewController* strongSelf = weakSelf;
+        if (!strongSelf || !pressed) {
+          return;
+        }
+        [strongSelf handleDirectionalClickFromCurrentDpad];
+      };
   if (@available(tvOS 13.0, *)) {
     gamepad.buttonMenu.pressedChangedHandler =
