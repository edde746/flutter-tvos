From 4858ef11cb5af87b3c5c2647f8e8dd40cecef1e3 Mon Sep 17 00:00:00 2001
From: edde746 <86283021+edde746@users.noreply.github.com>
Date: Thu, 23 Apr 2026 21:30:05 +0200
Subject: [PATCH 01/34] tvos: port DEPS to monorepo layout with LibertyGlobal
 forks


diff --git a/DEPS b/DEPS
index 6b0134d2..3a28b05c 100644
--- a/DEPS
+++ b/DEPS
@@ -8,6 +8,13 @@
 # to list the dependency's destination directory.
 
 vars = {
+  # tvOS port: LibertyGlobal forks pinned at 3.27.4. Note that the upstream
+  # 3.41.6 repo structure differs from 3.27.4: the buildroot was absorbed into
+  # the monorepo, and perfetto moved under dart/third_party. We keep the
+  # upc_git/upc_revision vars so the dart and skia deps below (and any follow-up
+  # hooks) can reference them. See TVOS_PORT_NOTES.md.
+  'upc_git': 'https://github.com/LibertyGlobal',
+  'upc_revision': '3.27.4',
   'android_git': 'https://android.googlesource.com',
   'chromium_git': 'https://chromium.googlesource.com',
   'swiftshader_git': 'https://swiftshader.googlesource.com',
@@ -294,7 +301,9 @@ deps = {
   #  Var('flutter_git') + '/third_party/protobuf-gn' + '@' + Var('dart_protobuf_gn_rev'),
 
   'engine/src/flutter/third_party/dart':
-   Var('dart_git') + '/sdk.git' + '@' + Var('dart_revision'),
+  # tvOS port: pointing at LibertyGlobal fork pinned at 3.27.4.
+  # Original: Var('dart_git') + '/sdk.git' + '@' + Var('dart_revision'),
+   Var('upc_git') + '/flutter-tvos-dart.git' + '@' + Var('upc_revision'),
 
   # WARNING: Unused Dart dependencies in the list below till "WARNING:" marker are removed automatically - see create_updated_flutter_deps.py.
 
@@ -486,7 +495,9 @@ deps = {
    Var('flutter_git') + '/third_party/freetype2' + '@' + 'bfc3453fdc85d87b45c896f68bf2e49ebdaeef0a',
 
   'engine/src/flutter/third_party/skia':
-   Var('skia_git') + '/skia.git' + '@' +  Var('skia_revision'),
+  # tvOS port: pointing at LibertyGlobal fork pinned at 3.27.4.
+  # Original: Var('skia_git') + '/skia.git' + '@' +  Var('skia_revision'),
+   Var('upc_git') + '/flutter-tvos-skia.git' + '@' + Var('upc_revision'),
 
   'engine/src/flutter/third_party/ocmock':
    Var('flutter_git') + '/third_party/ocmock' + '@' +  Var('ocmock_rev'),
