index 00000000..13ee60e6
--- /dev/null
+++ b/tvos_patches/apply.sh
@@ -0,0 +1,70 @@
+#!/bin/bash
+# Apply LibertyGlobal tvOS patches to gclient-synced dart and skia directories.
+# Run this after every `gclient sync -D` because gclient will reset the repos
+# to their DEPS-pinned revisions, wiping these local patches.
+#
+# The patches originate from:
+#   https://github.com/LibertyGlobal/flutter-tvos-dart  (branch 3.27.4)
+#   https://github.com/LibertyGlobal/flutter-tvos-skia  (branch 3.27.4)
+#
+# They were authored against Dart 3.6.2 and Skia @ ~2024-10-09. Flutter 3.41.6
+# uses newer revisions of both, so these patches may have conflicts that need
+# resolution. If `git apply` fails, inspect the rejected hunks (*.rej files)
+# and port the tvOS changes manually into the current upstream code.
+
+set -e
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
+REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
+
+DART_DIR="$REPO_ROOT/engine/src/flutter/third_party/dart"
+SKIA_DIR="$REPO_ROOT/engine/src/flutter/third_party/skia"
+
+apply_patch() {
+  local target="$1"
+  local patch="$2"
+  local name="$3"
+
+  if [ ! -d "$target" ]; then
+    echo "ERROR: $name directory not found at $target"
+    echo "Run 'gclient sync -D' from $REPO_ROOT first."
+    exit 1
+  fi
+
+  cd "$target"
+
+  # Check if already applied (look for a sentinel change from the patch).
+  if git log --oneline -1 --grep="tvos" | grep -q tvos 2>/dev/null; then
+    echo "[$name] tvOS patch appears already applied (found tvos commit). Skipping."
+    return
+  fi
+
+  echo "[$name] Checking patch application..."
+  if git apply --check "$patch" 2>/dev/null; then
+    echo "[$name] Applying patch..."
+    git apply "$patch"
+    git add -A
+    git -c user.name="tvOS port" -c user.email="tvos@local" \
+        commit -m "tvos 3.27.4 changes (ported from LibertyGlobal)" --no-verify
+    echo "[$name] Applied and committed."
+  else
+    echo "[$name] WARNING: patch does not apply cleanly against current tree."
+    echo "[$name] Falling back to 3-way merge..."
+    if git apply --3way "$patch"; then
+      git add -A
+      git -c user.name="tvOS port" -c user.email="tvos@local" \
+          commit -m "tvos 3.27.4 changes (ported from LibertyGlobal, 3-way)" --no-verify
+      echo "[$name] 3-way apply succeeded."
+    else
+      echo "[$name] 3-way apply also failed. Manual port required."
+      echo "[$name] See rejected hunks in $target"
+      echo "[$name] Reference original patch: $patch"
+      exit 1
+    fi
+  fi
+}
+
+apply_patch "$DART_DIR" "$SCRIPT_DIR/dart-tvos.diff" "dart"
+apply_patch "$SKIA_DIR" "$SCRIPT_DIR/skia-tvos.diff" "skia"
+
+echo "Done. dart and skia now carry local tvOS patches."
