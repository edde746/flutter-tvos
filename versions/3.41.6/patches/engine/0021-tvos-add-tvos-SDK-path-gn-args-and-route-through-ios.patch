From 46fba56d4fcba9a8437f14d6198cdda5ad54c96b Mon Sep 17 00:00:00 2001
From: edde746 <86283021+edde746@users.noreply.github.com>
Date: Thu, 23 Apr 2026 22:58:24 +0200
Subject: [PATCH 21/32] tvos: add tvos SDK path gn args and route through
 ios_sdk_path


diff --git a/engine/src/build/config/darwin/darwin_sdk.gni b/engine/src/build/config/darwin/darwin_sdk.gni
index 6c3cd0ce907..04f7ec873c2 100644
--- a/engine/src/build/config/darwin/darwin_sdk.gni
+++ b/engine/src/build/config/darwin/darwin_sdk.gni
@@ -68,6 +68,38 @@ declare_args() {
 
   # Version of iOS that we're targeting for tests.
   ios_testing_deployment_target = "13.0"
+
+  # tvOS build toggle (global). When true, the iOS target tree produces a
+  # tvOS-flavored Flutter.framework: omits WebKit/IOKit (not available on
+  # tvOS) and links GameController/MediaPlayer unconditionally for Siri
+  # Remote support. Defaults to false so vanilla iOS builds are unaffected.
+  is_tvos = false
+
+  # Set to true when targeting a simulator build on tvOS. Mirrors
+  # use_ios_simulator for the tvOS variant.
+  use_tvos_simulator = true
+
+  # Version of tvOS that we're targeting.
+  tvos_deployment_target = "14.0"
+
+  # Path to a specific version of the tvOS SDK, not including a backslash at
+  # the end.
+  #
+  # When empty, this will use the default SDK based on the value of
+  # use_tvos_simulator.
+  tvos_sdk_path = ""
+
+  # The path to the tvOS device platform.
+  tvos_device_platform_path = ""
+
+  # The path to the tvOS simulator platform.
+  tvos_simulator_platform_path = ""
+
+  # The path to the tvOS device SDK.
+  tvos_device_sdk_path = ""
+
+  # The path to the tvOS simulator SDK.
+  tvos_simulator_sdk_path = ""
 }
 
 if (target_os == "ios" || target_os == "macos") {
@@ -86,7 +118,7 @@ if (mac_host_toolchain_path == "" ||  #
     mac_platform_path == "") {
   _need_darwin_sdk_run = true
 }
-if (is_ios) {
+if (is_ios && !is_tvos) {
   if (use_ios_simulator &&
       (ios_simulator_platform_path == "" || ios_simulator_sdk_path == "")) {
     _need_darwin_sdk_run = true
@@ -96,6 +128,16 @@ if (is_ios) {
     _need_darwin_sdk_run = true
   }
 }
+if (is_ios && is_tvos) {
+  if (use_tvos_simulator &&
+      (tvos_simulator_platform_path == "" || tvos_simulator_sdk_path == "")) {
+    _need_darwin_sdk_run = true
+  }
+  if (!use_tvos_simulator &&
+      (tvos_device_platform_path == "" || tvos_device_sdk_path == "")) {
+    _need_darwin_sdk_run = true
+  }
+}
 if (_need_darwin_sdk_run) {
   _args = [ "--print-paths" ]
   if (use_rbe && create_xcode_symlinks) {
@@ -132,7 +174,7 @@ if (mac_swift_lib_paths == []) {
   ]
 }
 
-if (is_ios) {
+if (is_ios && !is_tvos) {
   if (ios_platform_path == "" || ios_sdk_path == "") {
     if (use_ios_simulator) {
       if (ios_simulator_platform_path == "") {
@@ -174,3 +216,51 @@ if (is_ios) {
     }
   }
 }
+
+# tvOS SDK path resolution. Piggybacks on the iOS plumbing: target_os is still
+# "ios" (so is_ios == true), and we overwrite ios_sdk_path/ios_platform_path to
+# point at the tvOS SDK so the existing toolchains continue to work. The
+# tvOS-specific toolchains in //build/toolchain/mac reference tvos_*_sdk_path
+# directly for version-min flags.
+if (is_ios && is_tvos) {
+  if (use_tvos_simulator) {
+    if (tvos_simulator_platform_path == "") {
+      tvos_simulator_platform_path = _sdk_result.appletvsimulator_platform_path
+    }
+    if (tvos_simulator_sdk_path == "") {
+      tvos_simulator_sdk_path = _sdk_result.appletvsimulator_sdk_path
+    }
+  } else {
+    if (tvos_device_platform_path == "") {
+      tvos_device_platform_path = _sdk_result.appletvos_platform_path
+    }
+    if (tvos_device_sdk_path == "") {
+      tvos_device_sdk_path = _sdk_result.appletvos_sdk_path
+    }
+  }
+
+  if (use_tvos_simulator) {
+    assert(tvos_simulator_platform_path != "")
+    assert(tvos_simulator_sdk_path != "")
+    tvos_sdk_path = tvos_simulator_sdk_path
+    ios_platform_path = tvos_simulator_platform_path
+    ios_sdk_path = tvos_simulator_sdk_path
+  } else {
+    assert(tvos_device_platform_path != "")
+    assert(tvos_device_sdk_path != "")
+    tvos_sdk_path = tvos_device_sdk_path
+    ios_platform_path = tvos_device_platform_path
+    ios_sdk_path = tvos_device_sdk_path
+  }
+
+  if (ios_swift_lib_paths == []) {
+    ios_swift_lib_paths += [ rebase_path("$ios_sdk_path/usr/lib/swift") ]
+    if (use_tvos_simulator) {
+      ios_swift_lib_paths += [ rebase_path(
+              "$mac_host_toolchain_path/usr/lib/swift/appletvsimulator") ]
+    } else {
+      ios_swift_lib_paths +=
+          [ rebase_path("$mac_host_toolchain_path/usr/lib/swift/appletvos") ]
+    }
+  }
+}
diff --git a/engine/src/flutter/shell/platform/darwin/ios/BUILD.gn b/engine/src/flutter/shell/platform/darwin/ios/BUILD.gn
index eeffd1e7d71..55e7da3eeff 100644
--- a/engine/src/flutter/shell/platform/darwin/ios/BUILD.gn
+++ b/engine/src/flutter/shell/platform/darwin/ios/BUILD.gn
@@ -4,13 +4,6 @@
 
 assert(is_ios)
 
-declare_args() {
-  # tvOS build toggle. When true, the iOS framework omits WebKit/IOKit (not
-  # available on tvOS) and links GameController/MediaPlayer unconditionally for
-  # Siri Remote support. Defaults to false so vanilla iOS builds are unaffected.
-  is_tvos = false
-}
-
 import("//build/config/darwin/darwin_sdk.gni")
 import("//build/toolchain/clang.gni")
 import("//build/toolchain/toolchain.gni")
