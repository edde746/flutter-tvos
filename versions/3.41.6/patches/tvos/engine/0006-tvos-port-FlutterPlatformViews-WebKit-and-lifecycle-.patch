                      animated:(BOOL)flag
                    completion:(void (^)(void))completion;
 @end
+#endif
 
 @implementation FlutterPlatformPluginTest
+// TODO tvos: update test for 3.41.6 API — tests excluded from tvOS build in BUILD.gn.
+#if !(defined(TARGET_OS_TV) && TARGET_OS_TV)
 
